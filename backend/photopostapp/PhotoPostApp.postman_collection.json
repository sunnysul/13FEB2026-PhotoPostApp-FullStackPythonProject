        {
            "name": "Photo Posts (User)",
            "description": "Endpoints requiring user authentication",
            "item": [
                {
                    "name": "Create Photo Post",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.post && jsonData.post.id) {",
                                    "    pm.collectionVariables.set('post_id', jsonData.post.id.toString());",
                                    "    console.log('Post ID saved: ' + jsonData.post.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Beautiful Sunset\",\n    \"description\": \"A beautiful sunset captured at the beach.\",\n    \"image_url\": \"https://example.com/images/sunset.jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/posts",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "posts"
                            ]
                        }
                    },
                    "response": []
                },
